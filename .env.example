# Configuración local. Copia este archivo a .env y genera tres contraseñas distintas
# para volúmenes nuevos. Para reutilizar datos, usa la configuración que los inicializó.
POSTGRES_USUARIOS_USER=app_usuarios
POSTGRES_USUARIOS_PASSWORD=ejemplo-usuarios-cambiar
POSTGRES_TRANSACCIONES_USER=app_transacciones
POSTGRES_TRANSACCIONES_PASSWORD=ejemplo-transacciones-cambiar
POSTGRES_NOTIFICACIONES_USER=app_notificaciones
POSTGRES_NOTIFICACIONES_PASSWORD=ejemplo-notificaciones-cambiar

# Puerto publicado únicamente en 127.0.0.1. Nginx escucha en 8080 dentro del contenedor.
FRONTEND_PORT=8080
VITE_DATA_MODE=demo
